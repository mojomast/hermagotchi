{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermagotchi.invalid/schema/contracts-v1/ledger_entry.schema.json",
  "title": "LedgerEntry",
  "description": "Append-only economy row. source_event_id is unique for refund-free idempotency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contracts_version",
    "id",
    "account_id",
    "delta",
    "reason",
    "source_event_id",
    "balance_after",
    "created_at"
  ],
  "properties": {
    "contracts_version": {"const": "contracts-v1"},
    "id": {"type": "string", "format": "uuid"},
    "account_id": {"type": "string", "format": "uuid"},
    "delta": {"type": "integer"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 64},
    "source_event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "balance_after": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
