{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermagotchi.invalid/schema/contracts-v1/appearance.schema.json",
  "title": "Appearance",
  "description": "Server-seeded, deterministic visual identity. Appearance never changes ranked damage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contracts_version", "species", "seed", "traits", "rig", "asset_pack_version"],
  "properties": {
    "contracts_version": {"const": "contracts-v1"},
    "species": {"enum": ["byteblob", "patchfox", "nullgeist"]},
    "seed": {"type": "string", "minLength": 8, "maxLength": 64},
    "traits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["palette", "feature", "marking"],
      "properties": {
        "palette": {"type": "string", "minLength": 2, "maxLength": 32},
        "feature": {"type": "string", "minLength": 2, "maxLength": 32},
        "marking": {"type": "string", "minLength": 2, "maxLength": 32}
      }
    },
    "rig": {"const": "small_front_v1"},
    "asset_pack_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
  }
}
