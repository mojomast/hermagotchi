{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermagotchi.invalid/schema/contracts-v1/item.schema.json",
  "title": "Item",
  "description": "Catalog cosmetic. One item per equipped slot; appearance only, no combat advantage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contracts_version",
    "id",
    "name",
    "slot",
    "rarity",
    "price_bits",
    "asset_id",
    "compatible_rigs",
    "catalog_version",
    "active"
  ],
  "properties": {
    "contracts_version": {"const": "contracts-v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*\\.[a-z0-9_]+$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 48},
    "slot": {"enum": ["head", "face", "back", "front", "aura", "emote", "habitat", "title"]},
    "rarity": {"enum": ["common", "uncommon", "rare", "epic", "legendary", "mythic"]},
    "price_bits": {"type": "integer", "minimum": 0},
    "asset_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "compatible_rigs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 64}
    },
    "catalog_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "active": {"type": "boolean"}
  }
}
