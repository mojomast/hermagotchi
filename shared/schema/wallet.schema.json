{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermagotchi.invalid/schema/contracts-v1/wallet.schema.json",
  "title": "Wallet",
  "description": "Server-owned Bits balance projection. Invariant: balance equals sum(ledger.delta).",
  "type": "object",
  "additionalProperties": false,
  "required": ["contracts_version", "account_id", "currency", "balance", "revision"],
  "properties": {
    "contracts_version": {"const": "contracts-v1"},
    "account_id": {"type": "string", "format": "uuid"},
    "currency": {"const": "bits"},
    "balance": {"type": "integer", "minimum": 0},
    "revision": {"type": "integer", "minimum": 0},
    "allowances": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "practice_daily_remaining": {"type": "integer", "minimum": 0},
        "practice_weekly_bits_remaining": {"type": "integer", "minimum": 0},
        "pvp_daily_remaining": {"type": "integer", "minimum": 0}
      }
    }
  }
}
