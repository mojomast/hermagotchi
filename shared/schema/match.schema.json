{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermagotchi.invalid/schema/contracts-v1/match.schema.json",
  "title": "Match",
  "description": "Authoritative match header. Seed and replay hash are committed by the server.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contracts_version",
    "id",
    "challenge_id",
    "ruleset_version",
    "economy_version",
    "seed_commitment",
    "seed",
    "status",
    "replay_hash",
    "created_at",
    "resolved_at"
  ],
  "properties": {
    "contracts_version": {"const": "contracts-v1"},
    "id": {"type": "string", "format": "uuid"},
    "challenge_id": {"type": "string", "format": "uuid"},
    "ruleset_version": {"const": "battle-1"},
    "economy_version": {"const": "economy-1"},
    "seed_commitment": {"type": "string", "minLength": 16, "maxLength": 128},
    "seed": {"type": ["string", "null"], "maxLength": 128},
    "status": {"enum": ["pending", "resolved", "expired"]},
    "replay_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "resolved_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
