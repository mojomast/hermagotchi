{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermagotchi.local/schemas/asset-manifest-v1.json",
  "title": "Hermagotchi Asset Manifest (contracts-v1)",
  "description": "Normative shape for assets/manifest.json. Canvas is 512x512 RGBA. Equipped slots: head, face, back, front, aura, emote, habitat, title. Z-order vocabulary: aura_back=-30, shadow=-20, back_attachment=-10, body=0, markings=5, eyes_mouth=10, facewear=20, headwear=30, front_attachment=40, particles_front=50.",
  "type": "object",
  "required": ["schema_version", "asset_pack_id", "canvas", "rigs", "species", "assets"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "asset_pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "notes": {
      "type": "string",
      "description": "Free-form release notes. Placeholder packs must contain PLACEHOLDER_NOT_SHIP."
    },
    "canvas": {
      "$ref": "#/$defs/canvas"
    },
    "rigs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/rig"
      }
    },
    "species": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/species"
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "anchor_point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "description": "Normalized (x, y) in [0,1] relative to the 512x512 canvas."
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "baseline_y"],
      "additionalProperties": false,
      "properties": {
        "width": {
          "const": 512
        },
        "height": {
          "const": 512
        },
        "baseline_y": {
          "const": 448
        }
      }
    },
    "rig": {
      "type": "object",
      "required": ["anchors"],
      "additionalProperties": false,
      "properties": {
        "anchors": {
          "type": "object",
          "required": ["head", "face", "back", "front", "ground"],
          "additionalProperties": {
            "$ref": "#/$defs/anchor_point"
          }
        }
      }
    },
    "species": {
      "type": "object",
      "required": ["rig", "base", "overrides", "features"],
      "additionalProperties": false,
      "properties": {
        "rig": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\.png$"
        },
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/anchor_point"
          },
          "description": "Per-species anchor overrides. Keys must be anchors declared by the rig."
        },
        "features": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "Feature switches such as ear_type, tail_type, marking, eye_style, horn_type, mouth_style."
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "slot",
        "path",
        "rig_families",
        "z",
        "anchor",
        "offset_px",
        "scale",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{1,127}$"
        },
        "slot": {
          "type": "string",
          "enum": ["head", "face", "back", "front", "aura", "emote", "habitat", "title"]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\.png$"
        },
        "rig_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "z": {
          "type": "integer",
          "enum": [-30, -20, -10, 0, 5, 10, 20, 30, 40, 50],
          "description": "Z-order vocabulary: aura_back(-30), shadow(-20), back(-10), body(0), markings(5), eyes_mouth(10), face(20), head(30), front(40), particles_front(50)."
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "offset_px": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": -512,
            "maximum": 512
          }
        },
        "scale": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 4
        },
        "occludes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        },
        "placeholder": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
